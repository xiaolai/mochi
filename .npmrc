# Electron's native binary is hard to resolve under pnpm's strict node_modules
# layout. The hoisted linker avoids it; this is the standard recommendation for
# electron-vite projects, and it is set now rather than at M0 so the layout does
# not change under an installed tree.
node-linker=hoisted

# Refuse to install under a toolchain the project does not target.
#
# `engines` in package.json is advisory by default: pnpm warns and carries on,
# so somebody on Node 20 gets a confusing failure somewhere in the build instead
# of a clear one at install.
engine-strict=true
