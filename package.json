{
  "name": "@hando/mochi",
  "version": "1.0.0",
  "description": "Mochi — a soft-body companion character, and the engine that draws her. Superellipse geometry, area-preserving squash, spring physics and an idle layer. Canvas2D, SVG, or one custom element. Zero runtime dependencies.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "HANDO K.K.",
  "homepage": "https://github.com/xiaolai/mochi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaolai/mochi.git"
  },
  "bugs": "https://github.com/xiaolai/mochi/issues",
  "type": "module",
  "sideEffects": [
    "./dist/element/index.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element/index.d.ts",
      "default": "./dist/element/index.js"
    },
    "./characters": {
      "types": "./dist/characters/index.d.ts",
      "default": "./dist/characters/index.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./canvas2d/*": {
      "types": "./dist/canvas2d/*.d.ts",
      "default": "./dist/canvas2d/*.js"
    },
    "./svg/*": {
      "types": "./dist/svg/*.d.ts",
      "default": "./dist/svg/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "BRAND.md"
  ],
  "keywords": [
    "avatar",
    "character",
    "mascot",
    "canvas",
    "svg",
    "custom-element",
    "web-component",
    "superellipse",
    "spring",
    "animation"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm verify"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.6",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
