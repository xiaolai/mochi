{
  "name": "@hando/dough",
  "version": "0.1.0",
  "private": true,
  "description": "A soft-body companion character engine \u2014 superellipse geometry, area-preserving squash, spring physics and an idle layer. Renders to any Canvas2D context or to SVG. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/element/index.ts"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core/*": "./src/core/*.ts",
    "./canvas2d/*": "./src/canvas2d/*.ts",
    "./svg/*": "./src/svg/*.ts",
    "./element": "./src/element/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "avatar",
    "character",
    "canvas",
    "svg",
    "superellipse",
    "spring",
    "mascot"
  ],
  "engines": {
    "node": ">=20"
  }
}
