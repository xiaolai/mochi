{
  // One project, because there is one thing to check now. The solution-style
  // split existed to keep the renderer's DOM types apart from Electron's Node
  // types, and neither process survives.
  //
  // NOT `composite`, and that is deliberate. Composite implies incremental,
  // which writes a `.tsbuildinfo` and lets tsc decide it has already checked a
  // file — this gate once reported SUCCESS over three real errors until the
  // files were touched again. A typecheck that is slightly slower and always
  // tells the truth is the better trade.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // NodeNext, not `bundler`. A published package has to resolve under plain
    // Node, and `bundler` lets extensionless relative imports typecheck that
    // Node then refuses to load — which is exactly how the manifest ended up
    // unpublishable. Under NodeNext the source names the emitted path.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "vitest.config.ts"]
}
