{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // `scripts/make-icons.ts` imports the rig under bare `node`, which resolves
    // no aliases and needs the real extension. Permitted, not required.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@rig/*": ["./src/renderer/companion/rig/*"]
    }
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "scripts/face-tuner/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
